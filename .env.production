# C3DS Frontend - Production Environment Variables
# These are build-time variables for Vite (must be prefixed with VITE_)

VITE_BACKEND_URL=https://illustrious-endurance-production.up.railway.app

# API Base URL (relative URL - nginx reverse proxy handles routing)
VITE_API_BASE_URL=/api/v1

# Thunderforest API Key for map tiles
# Get your API key from: https://www.thunderforest.com/
# Set VITE_THUNDERFOREST_API_KEY in Railway environment variables
